# Get your API key from https://resend.com/api-keys
    =re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# From address — must be a verified domain in your Resend account
# During testing you can use: onboarding@resend.dev  (only delivers to your Resend account email)
RESEND_FROM_EMAIL=National Majestic <notifications@yourdomain.com>

# Contact numbers (displayed site-wide — callback button, WhatsApp, footer)
# Format: +91 XXXXX XXXXX  (spaces are stripped automatically for tel:/wa.me links)
NEXT_PUBLIC_PHONE_1=+91 98475 33355
NEXT_PUBLIC_PHONE_2=+91 98475 44222
NEXT_PUBLIC_PHONE_3=+91 98477 17771
